# =================================================================
# CampusConnect Backend - Environment Configuration
# =================================================================

# Server Port
PORT=5000

# Environment Mode (development | production | test)
NODE_ENV=development

# MongoDB Connection String (Practical 7)
# For Local MongoDB Server:
MONGODB_URI=mongodb://127.0.0.1:27017/campusconnect

# For MongoDB Atlas (Cloud Database):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/campusconnect?retryWrites=true&w=majority

# Frontend Client Origin (for CORS security in production)
CLIENT_ORIGIN=http://localhost:3001
