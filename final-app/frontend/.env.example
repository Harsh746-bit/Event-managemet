# CampusConnect Frontend - Environment Configuration
# API Base URL for Express REST Backend
# In local development with Vite proxy, empty or default can be used:
VITE_API_URL=http://localhost:5000/api

# In production (e.g. deployed on Vercel/Netlify pointing to Render backend):
# VITE_API_URL=https://campusconnect-backend.onrender.com/api
