            "description": "Filter events dynamically by category."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"All returned events match Technology category\", function () {",
                  "    var json = pm.response.json();",
                  "    json.data.forEach(function(item) {",
                  "        pm.expect(item.category.toLowerCase()).to.eql(\"technology\");",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
