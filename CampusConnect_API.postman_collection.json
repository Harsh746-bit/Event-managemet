      "name": "01. Diagnostics & Health",
      "item": [
        {
          "name": "1. Health Check & MongoDB State",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Verifies that the Express server is up and MongoDB is connected."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Server is healthy and MongoDB is connected\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql(\"healthy\");",
                  "    pm.expect(json.database.status).to.eql(\"connected\");",
                  "    pm.expect(json.database.type).to.eql(\"MongoDB\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
