{
  "version": 2,
  "buildCommand": "cd final-app/frontend && npm install --include=dev && npm run build",
  "outputDirectory": "final-app/frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
